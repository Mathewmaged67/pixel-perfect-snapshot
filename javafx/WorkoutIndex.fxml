<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="WorkoutIndexController" styleClass="app-root">
  <left>
    <fx:include source="Nav.fxml" fx:id="nav" />
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
      <content>
        <VBox spacing="16" styleClass="content">
          <Label text="Workout" styleClass="page-title" />

          <HBox spacing="16">
            <VBox spacing="8" styleClass="card" prefWidth="360">
              <Label text="Pick exercises" styleClass="section-title" />
              <TextField fx:id="searchField" promptText="Search exercise" styleClass="input" />
              <ListView fx:id="exerciseList" prefHeight="320" />
              <Button text="Add selected" onAction="#onAddExercise" styleClass="primary-button" />
            </VBox>

            <VBox spacing="8" styleClass="card" prefWidth="360">
              <Label text="Session setup" styleClass="section-title" />
              <TextField fx:id="sessionNameField" promptText="Session name" styleClass="input" />
              <ListView fx:id="selectedList" prefHeight="240" />
              <HBox spacing="10">
                <Button text="Remove selected" onAction="#onRemoveExercise" styleClass="ghost-button" />
                <Button text="Begin quest" onAction="#onBegin" styleClass="primary-button" />
              </HBox>
              <HBox spacing="10">
                <Button text="History" onAction="#onHistory" styleClass="ghost-button" />
                <Button text="Templates" onAction="#onTemplates" styleClass="ghost-button" />
              </HBox>
              <Label fx:id="statusLabel" styleClass="muted" />
            </VBox>
          </HBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
