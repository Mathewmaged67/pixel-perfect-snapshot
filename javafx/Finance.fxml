<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="FinanceController" styleClass="app-root">
  <left>
    <fx:include source="Nav.fxml" fx:id="nav" />
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
      <content>
        <VBox spacing="20" styleClass="content">
          <Label text="FINANCE" styleClass="page-title" />

          <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="finance-tab-pane">
            <!-- Tab 1: Transaction Management -->
            <Tab text="Transactions" styleClass="finance-tab">
              <content>
                <VBox spacing="16" styleClass="finance-tab-content">
                  <VBox spacing="10" styleClass="card">
                    <Label text="Manage Transactions" styleClass="card-title" />
                    <GridPane hgap="12" vgap="10">
                      <Label text="Name:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                      <TextField fx:id="transactionNameField" promptText="e.g. Freelance Payment" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                      <Label text="Amount:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                      <TextField fx:id="transactionAmountField" promptText="e.g. 250.00" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                      <Label text="Type:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                      <ComboBox fx:id="transactionTypeCombo" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                      <Label text="Date:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                      <DatePicker fx:id="transactionDatePicker" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </GridPane>

                    <HBox spacing="10">
                      <Button text="Add Transaction" onAction="#onAddTransaction" styleClass="primary-button" />
                      <Button text="Edit" onAction="#onEditTransaction" styleClass="ghost-button" />
                      <Button text="Delete" onAction="#onDeleteTransaction" styleClass="ghost-button" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Button text="View List" onAction="#onViewTransactionList" styleClass="link-button" />
                    </HBox>
                  </VBox>

                  <VBox spacing="8" styleClass="card">
                    <Label text="Transaction List" styleClass="card-title" />
                    <TableView fx:id="transactionTable" styleClass="finance-table">
                      <columns>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="200" />
                        <TableColumn fx:id="amountColumn" text="Amount" prefWidth="120" />
                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="100" />
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="130" />
                      </columns>
                    </TableView>
                  </VBox>
                </VBox>
              </content>
            </Tab>

            <!-- Tab 2: Resource Tracking -->
            <Tab text="Resources" styleClass="finance-tab">
              <content>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
                  <content>
                    <VBox spacing="16" styleClass="finance-tab-content">
                      <Label text="Resource Tracking" styleClass="card-title" />
                      <VBox fx:id="resourceCardsBox" spacing="12" />
                    </VBox>
                  </content>
                </ScrollPane>
              </content>
            </Tab>

            <!-- Tab 3: Financial Summary -->
            <Tab text="Financial Summary" styleClass="finance-tab">
              <content>
                <VBox spacing="16" styleClass="finance-tab-content">
                  <Label text="Financial Overview" styleClass="card-title" />
                  <HBox spacing="16" styleClass="finance-summary-cards">
                    <VBox spacing="8" styleClass="card finance-card-income" HBox.hgrow="ALWAYS">
                      <Label text="Total Income" styleClass="eyebrow" />
                      <Label fx:id="totalIncomeLabel" text="\$0.00" styleClass="finance-amount income-amount" />
                    </VBox>
                    <VBox spacing="8" styleClass="card finance-card-expense" HBox.hgrow="ALWAYS">
                      <Label text="Total Expenses" styleClass="eyebrow" />
                      <Label fx:id="totalExpensesLabel" text="\$0.00" styleClass="finance-amount expense-amount" />
                    </VBox>
                    <VBox spacing="8" styleClass="card finance-card-balance" HBox.hgrow="ALWAYS">
                      <Label text="Net Balance" styleClass="eyebrow" />
                      <Label fx:id="netBalanceLabel" text="\$0.00" styleClass="finance-amount balance-amount" />
                    </VBox>
                  </HBox>
                </VBox>
              </content>
            </Tab>

            <!-- Tab 4: Private Coach -->
            <Tab text="Coach" styleClass="finance-tab">
              <content>
                <VBox spacing="12" styleClass="finance-tab-content">
                  <Label text="Private Coach" styleClass="card-title" />
                  <Label text="Your personal finance assistant. Ask me anything about managing your finances!" styleClass="muted" wrapText="true" />
                  <VBox VBox.vgrow="ALWAYS" spacing="10" styleClass="card coach-chat-box">
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                      <content>
                        <VBox fx:id="chatMessageBox" spacing="8" styleClass="coach-message-box" />
                      </content>
                    </ScrollPane>
                    <HBox spacing="10">
                      <TextField fx:id="chatInputField" promptText="Ask your coach..." styleClass="form-input" HBox.hgrow="ALWAYS" />
                      <Button text="Send" onAction="#onSendChat" styleClass="primary-button" />
                    </HBox>
                  </VBox>
                </VBox>
              </content>
            </Tab>
          </TabPane>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
