<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="NutritionPostWorkoutController" styleClass="app-root">
  <left>
    <fx:include source="Nav.fxml" fx:id="nav" />
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
      <content>
        <VBox spacing="16" styleClass="content">
          <Label text="Post Workout" styleClass="page-title" />
          <HBox spacing="10">
            <Button text="Today" onAction="#onTabToday" styleClass="ghost-button" />
            <Button text="Log" onAction="#onTabLog" styleClass="ghost-button" />
            <Button text="Goals" onAction="#onTabGoals" styleClass="ghost-button" />
            <Button text="Post-workout" onAction="#onTabPost" styleClass="ghost-button" />
          </HBox>

          <VBox spacing="10" styleClass="card">
            <Label text="Recovery Targets" styleClass="section-title" />
            <GridPane hgap="12" vgap="8">
              <Label text="Calories" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="0" />
              <Label fx:id="kcalLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" />
              <Label text="Protein" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="1" />
              <Label fx:id="proteinLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
              <Label text="Carbs" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="2" />
              <Label fx:id="carbsLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />
              <Label text="Fat" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="3" />
              <Label fx:id="fatLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>
          </VBox>

          <VBox spacing="10" styleClass="card">
            <Label text="Quick picks" styleClass="section-title" />
            <HBox spacing="10">
              <Button fx:id="chickenButton" text="Chicken + Rice" onAction="#onChicken" styleClass="primary-button" />
              <Button fx:id="wheyButton" text="Whey Shake" onAction="#onWhey" styleClass="primary-button" />
              <Button fx:id="tempehButton" text="Tempeh Bowl" onAction="#onTempeh" styleClass="primary-button" />
            </HBox>
            <Label fx:id="statusLabel" styleClass="muted" />
          </VBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
