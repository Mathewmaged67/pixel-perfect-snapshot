<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="WorkoutActiveController" styleClass="app-root">
  <left>
    <fx:include source="Nav.fxml" fx:id="nav" />
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
      <content>
        <VBox spacing="16" styleClass="content">
          <Label text="Active Session" styleClass="page-title" />

          <HBox spacing="20">
            <Label fx:id="sessionNameLabel" />
            <Label fx:id="timerLabel" styleClass="muted" />
            <Label fx:id="xpPreviewLabel" styleClass="muted" />
          </HBox>

          <HBox spacing="16">
            <VBox spacing="8" styleClass="card" prefWidth="260">
              <Label text="Exercises" styleClass="section-title" />
              <ListView fx:id="exerciseList" prefHeight="320" />
              <Button text="Add set" onAction="#onAddSet" styleClass="ghost-button" />
            </VBox>

            <VBox spacing="8" styleClass="card" prefWidth="640">
              <Label text="Sets" styleClass="section-title" />
              <TableView fx:id="setTable" editable="true" prefHeight="320">
                <columns>
                  <TableColumn fx:id="setNumberCol" text="#" prefWidth="60" />
                  <TableColumn fx:id="weightCol" text="Weight" prefWidth="160" />
                  <TableColumn fx:id="repsCol" text="Reps" prefWidth="120" />
                  <TableColumn fx:id="doneCol" text="Done" prefWidth="80" />
                </columns>
              </TableView>
              <HBox spacing="10">
                <Button text="Remove set" onAction="#onRemoveSet" styleClass="ghost-button" />
                <ComboBox fx:id="addExerciseCombo" promptText="Add exercise" prefWidth="220" />
                <Button text="Add exercise" onAction="#onAddExercise" styleClass="ghost-button" />
                <Button text="Finish" onAction="#onFinish" styleClass="primary-button" />
              </HBox>
              <Label fx:id="statusLabel" styleClass="muted" />
            </VBox>
          </HBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
