<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="NutritionTodayController" styleClass="app-root">
  <left>
    <fx:include source="Nav.fxml" fx:id="nav" />
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
      <content>
        <VBox spacing="16" styleClass="content">
          <Label text="Nutrition Today" styleClass="page-title" />
          <HBox spacing="10">
            <Button text="Today" onAction="#onTabToday" styleClass="ghost-button" />
            <Button text="Log" onAction="#onTabLog" styleClass="ghost-button" />
            <Button text="Goals" onAction="#onTabGoals" styleClass="ghost-button" />
            <Button text="Post-workout" onAction="#onTabPost" styleClass="ghost-button" />
          </HBox>

          <HBox spacing="16">
            <VBox spacing="10" styleClass="card" prefWidth="320">
              <Label text="Macro Targets" styleClass="section-title" />
              <Label fx:id="caloriesLabel" styleClass="muted" />
              <GridPane hgap="10" vgap="8">
                <Label text="Protein" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <ProgressBar fx:id="proteinBar" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label fx:id="proteinLabel" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label text="Carbs" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ProgressBar fx:id="carbsBar" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label fx:id="carbsLabel" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Label text="Fat" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ProgressBar fx:id="fatBar" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label fx:id="fatLabel" GridPane.columnIndex="2" GridPane.rowIndex="2" />
              </GridPane>
            </VBox>

            <VBox spacing="10" styleClass="card" prefWidth="360">
              <Label text="Recent Log" styleClass="section-title" />
              <ListView fx:id="logList" prefHeight="220" />
            </VBox>
          </HBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
