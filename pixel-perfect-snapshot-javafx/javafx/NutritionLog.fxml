<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="NutritionLogController" styleClass="app-root">
  <left>
    <fx:include source="Nav.fxml" fx:id="nav" />
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
      <content>
        <VBox spacing="16" styleClass="content">
          <Label text="Nutrition Log" styleClass="page-title" />
          <HBox spacing="10">
            <Button text="Today" onAction="#onTabToday" styleClass="ghost-button" />
            <Button text="Log" onAction="#onTabLog" styleClass="ghost-button" />
            <Button text="Goals" onAction="#onTabGoals" styleClass="ghost-button" />
            <Button text="Post-workout" onAction="#onTabPost" styleClass="ghost-button" />
          </HBox>

          <VBox spacing="8" styleClass="card">
            <Label text="Search foods" styleClass="section-title" />
            <TextField fx:id="searchField" promptText="Search food" styleClass="input" />
            <ListView fx:id="foodList" prefHeight="280" />
            <HBox spacing="10">
              <Label text="Servings" styleClass="muted" />
              <TextField fx:id="servingsField" text="1" prefWidth="80" styleClass="input" />
              <Button fx:id="logButton" text="Log meal" onAction="#onLogMeal" styleClass="primary-button" />
            </HBox>
            <Label fx:id="statusLabel" styleClass="muted" />
          </VBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
