<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="QuestsController" styleClass="app-root">
  <left>
    <fx:include source="Nav.fxml" fx:id="nav" />
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
      <content>
        <VBox spacing="18" styleClass="content">
          <Label text="Quest Board" styleClass="page-title" />

          <VBox spacing="8">
            <Label text="Daily" styleClass="section-title" />
            <FlowPane fx:id="dailyPane" hgap="12" vgap="12" />
          </VBox>

          <VBox spacing="8">
            <Label text="Weekly" styleClass="section-title" />
            <FlowPane fx:id="weeklyPane" hgap="12" vgap="12" />
          </VBox>

          <VBox spacing="8">
            <Label text="Epic" styleClass="section-title" />
            <FlowPane fx:id="epicPane" hgap="12" vgap="12" />
          </VBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
