<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="WorkoutSummaryController" styleClass="app-root">
  <left>
    <fx:include source="Nav.fxml" fx:id="nav" />
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
      <content>
        <VBox spacing="16" styleClass="content">
          <Label text="Workout Summary" styleClass="page-title" />
          <VBox spacing="10" styleClass="card">
            <GridPane hgap="12" vgap="8">
              <Label text="Session" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="0" />
              <Label fx:id="sessionLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" />
              <Label text="Volume" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="1" />
              <Label fx:id="volumeLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
              <Label text="Sets" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="2" />
              <Label fx:id="setsLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />
              <Label text="Duration" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="3" />
              <Label fx:id="durationLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" />
              <Label text="XP" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="4" />
              <Label fx:id="xpLabel" GridPane.columnIndex="1" GridPane.rowIndex="4" />
              <Label text="STR/STA/AGI" styleClass="muted" GridPane.columnIndex="0" GridPane.rowIndex="5" />
              <Label fx:id="xpBreakdownLabel" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            </GridPane>
            <Button text="Post-workout nutrition" onAction="#onGoNutrition" styleClass="primary-button" />
          </VBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
